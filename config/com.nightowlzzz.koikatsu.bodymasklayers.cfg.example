## Example configuration for KK_BodyMaskLayers 0.3.1.
## BepInEx creates the live configuration when the plugin starts.

[General]

## Restores the upstream body mask without deleting stored clothing masks when false.
# Setting type: Boolean
# Default value: true
Enabled = true

[Masks]

## Composition size used only when the upstream body mask has no usable size.
## Embedded PNG data has a fixed 32 MiB cap.
# Setting type: Int32
# Default value: 512
Default output resolution = 512

## Exact, Threshold, or NearestCategory.
# Setting type: ColorClassificationMode
# Default value: Threshold
Color classification = Threshold

## RGB tolerance used by Threshold classification.
# Setting type: Int32
# Default value: 12
ColorTolerance = 12

## RejectMask, NoContribution, or HideWhenNotOff.
# Setting type: UnknownColorPolicy
# Default value: RejectMask
UnknownColorPolicy = RejectMask

## Auto preserves compatible R/G coverage. PreserveContinuous accepts explicit R/G
## state coverage. StrictCategorical accepts only the defined categorical palette.
## The selected mode is stored with each newly imported layer.
# Setting type: GradientHandlingMode
# Default value: Auto
Gradient Handling = Auto

[States]

## Behavior for clothing state values outside the supported 0..3 range.
# Setting type: UnknownStatePolicy
# Default value: NoContribution
UnknownStatePolicy = NoContribution

[Diagnostics]

## Enables diagnostic debug messages and numeric runtime counters.
# Setting type: Boolean
# Default value: false
DebugLogging = false

## Logs clothing state, item, and availability transitions.
# Setting type: Boolean
# Default value: false
LogStateChanges = false

## Logs composition timing for dirty mask rebuilds.
# Setting type: Boolean
# Default value: false
LogComposition = false

## Minimum spacing for repeated diagnostic messages, in seconds.
# Setting type: Single
# Default value: 1
LogIntervalSeconds = 1

## Writes a diagnostic snapshot to the log and the BepInEx config directory.
## Uses BepInEx KeyboardShortcut syntax.
# Setting type: KeyboardShortcut
# Default value: F8 + LeftControl
DumpDiagnosticsShortcut = F8 + LeftControl
